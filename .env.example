# Copy to .env and fill in.

DATABASE_URL=postgresql+psycopg://breakmyapi:breakmyapi@localhost:5433/breakmyapi

# Groq (free tier): get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_STRONG=openai/gpt-oss-120b

# Safety rule 2: until ownership verification exists (week 4),
# only these targets can be scanned. Comma-separated origins.
ALLOWED_TARGETS=http://localhost:8001,http://127.0.0.1:8001

# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173
